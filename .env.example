# Supabase project URL and anon key. Leave both blank for demo mode.
# Apply supabase/migrations/20261031120000_business_tables.sql
# and supabase/migrations/20261031150000_whatsapp_connections.sql before expecting saved rows.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Meta app from developers.facebook.com → App settings → Basic.
# Leave blank until the app exists. Do not commit real values.
# META_APP_ID and META_APP_SECRET start WhatsApp OAuth / embedded signup
# and check the webhook signature (X-Hub-Signature-256).
META_APP_ID=
META_APP_SECRET=

# Optional. Facebook Login for Business → Configurations → Configuration ID.
# When set, Connect with Meta opens WhatsApp embedded signup v4.
# When blank, Connect with Meta uses WhatsApp OAuth scopes instead.
META_EMBEDDED_SIGNUP_CONFIG_ID=

# Cloud API token and the phone number ID it can send from
# (WhatsApp → API Setup in the Meta app). Either paste both in Settings,
# or set them here and choose "Use the number saved on the server".
# A temporary token from API Setup expires. A system-user token lasts longer.
# This app does not buy numbers or send paid template messages.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# The verify token you type into Meta's webhook form. Use a long random string
# (at least 8 characters). The same value must stay on the server.
# Open Settings once after changing it so inbound messages keep saving.
WEBHOOK_VERIFY_TOKEN=
